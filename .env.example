# Rosario AI — set this to let the concierge answer with Claude.
# Without it, Rosario falls back to a built-in offline concierge so the site still works.
ANTHROPIC_API_KEY=
# Optional model override
ROSARIO_MODEL=claude-sonnet-5-5

# Admin portal passcode (checked server-side; demo default: rosario)
ADMIN_PASSCODE=rosario
NEXT_PUBLIC_SITE_URL=https://rosario.travel

# Shared database for bookings, inquiries, wheel leads, chats and subscribers.
# Without these, everything stays in each visitor's browser (demo mode).
# Supabase dashboard → Project Settings → API. The secret key is server-only: never prefix it with NEXT_PUBLIC_.
# Schema: supabase/migrations/20261107000000_shared_store.sql
# When these are set, ADMIN_PASSCODE has no default: set a strong one.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
